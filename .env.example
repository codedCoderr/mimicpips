# Generate with: openssl rand -hex 32
SESSION_SECRET=

SAAS_SERVICE_KEY=

BOT_SERVER_URL=

NEXT_PUBLIC_APP_URL=

PAYSTACK_SECRET_KEY=

MONGO_URI=

SAAS_DB_NAME=

PORT=

USD_TO_NGN_RATE=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set true on the long-running dashboard process that should consume
# bot trade events and fan them out to enabled followers.
COPY_TRADE_WORKER_ENABLED=true

# Copy-trading balance policy.
# Followers need this much available balance to enable copy trading.
COPY_TRADE_MIN_ACTIVATION_BALANCE_USDT=300
# UI warning threshold for low balances after activation.
COPY_TRADE_WARN_BALANCE_USDT=250
# New copy-trade entries are paused below this runtime floor.
COPY_TRADE_PAUSE_BALANCE_USDT=150
# Individual copied orders sized below this notional are skipped.
COPY_TRADE_MIN_ORDER_NOTIONAL_USDT=25
